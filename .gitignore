.devflow/hooks-local/
.devflow/state.json
.devflow/state.log
.devflow/tasks.json
.devflow/epics.json
.devflow/ideate.json
.devflow/decisions.json
.devflow/state
.devflow/escalation.json

# Sensitive files (prevent accidental commits)
.env
*.key
credentials

