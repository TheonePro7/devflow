.DS_Store
node_modules/
.claude/settings.local.json

# Agent Memory MCP auto-generated config
.claude/hooks.json

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# GitNexus cache (regenerated on setup)
.gitnexus/
.beads/

# GitNexus auto-generated skills (from hooks)
.claude/skills/

# Python bytecache
__pycache__/
*.pyc

# Python egg info
*.egg-info/

# Agent skills (auto-installed)
.agents/
skills-lock.json

# Devflow local state (not the code itself)
.devflow/hooks-local/
.devflow/state.json
.devflow/state.log
.devflow/tasks.json
.devflow/epics.json
.devflow/ideate.json
.devflow/decisions.json
