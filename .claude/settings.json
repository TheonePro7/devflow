  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bd prime"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/guardrails-git.ps1",
            "shell": "powershell",
            "timeout": 5,
            "statusMessage": "devflow: checking git safety..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/devflow-init-check.ps1",
            "shell": "powershell",
            "timeout": 10,
            "statusMessage": "devflow: checking devflow init state..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/beads-export.ps1",
            "shell": "powershell",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File .claude/hooks/session-start.ps1"
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -Command \"$m=Get-Content -Path '.claude\\hooks\\devflow-prime.ps1' -Raw -ErrorAction SilentlyContinue; if($m){ iex $m }\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
