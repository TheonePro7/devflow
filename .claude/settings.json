{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "powershell -NoProfile -File .claude/hooks/guardrails-git.ps1",
            "shell": "powershell",
            "statusMessage": "devflow: checking git safety...",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "powershell -File .claude/hooks/devflow-init-check.ps1",
            "shell": "powershell",
            "statusMessage": "devflow: checking project state...",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "additionalDirectories": [
      "C:\\Users\\Administrator\\.claude\\skills\\superpowers-brainstorming",
      "C:\\Users\\Administrator\\.claude\\skills\\superpowers-writing-plans",
      "C:\\Users\\Administrator\\.claude\\skills\\superpowers-using-git-worktrees",
      "C:\\Users\\Administrator\\.claude\\skills\\superpowers-subagent-driven-development",
      "C:\\Users\\Administrator\\.claude\\skills\\superpowers-requesting-code-review",
      "C:\\Users\\Administrator\\.claude\\skills\\superpowers-finishing-a-development-branch",
      "C:\\Users\\Administrator\\.claude\\skills\\superpowers-test-driven-development"
    ]
  }
}